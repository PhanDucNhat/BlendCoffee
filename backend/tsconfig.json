{
  "compilerOptions": {
    // Đường dẫn build
    "rootDir": "./src",
    "outDir": "./dist",

    // Môi trường Node + ESM
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "target": "ES2020",
    "lib": ["ESNext"],
    "types": ["node"],
    "esModuleInterop": true,

    // Kiểu dữ liệu nghiêm ngặt
    "strict": true,
    "skipLibCheck": true,

    // Bản đồ và file khai báo
    "sourceMap": true,
    "declaration": true,
    "declarationMap": true,

    // Bật JSX cho React nếu bạn dùng chung project frontend (tùy chọn)
    "jsx": "react-jsx"
  },
  "include": ["src"]
}
